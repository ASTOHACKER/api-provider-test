# Server (used only for local dev with `npm run dev`)
PORT=8787
HOST=0.0.0.0

# Admin bootstrap key (used to call /admin/* endpoints).
# Generate a new one: openssl rand -hex 32
ADMIN_API_KEY=change-me-admin-secret

# Postgres connection string (required on Vercel).
# Use Neon (free): https://neon.tech — copy the pooled "pooler" connection string.
# Must be set in Vercel project environment variables too.
DATABASE_URL=

# 32-byte hex key used to encrypt provider API keys at rest.
# Generate: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=

# Default upstream providers are seeded into the DB on first run from these vars.
# Set API keys here so they get seeded; leave blank to configure later via
# the /admin/providers API.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GLM_API_KEY=
